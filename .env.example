APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql+psycopg://tomoshibiyori:change-me-local@db:5432/tomoshibiyori
MARKET_DATA_PROVIDER=alpha_vantage
NOTIFICATION_DRY_RUN=true
ALPHA_VANTAGE_API_KEY=
MARKET_ENVIRONMENT_REQUEST_INTERVAL_SECONDS=12.1
JQUANTS_API_KEY=
JQUANTS_PLAN=light
MARKET_SCREENING_LIMIT=500
SLACK_WEBHOOK_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_MAX_OUTPUT_TOKENS=6000

# Next.js BFFとFastAPI間だけで共有する32文字以上の秘密値。
# 外部公開前は必ずランダム値へ変更し、ブラウザーへ渡さないでください。
INTERNAL_API_TOKEN=change-this-local-token-before-deploying

# ローカル開発時だけ認証なしでNext.js画面を確認できます。
# productionではこの値がtrueでも認証を迂回しません。
AUTH_ALLOW_INSECURE_LOCAL=true
AUTH_SECRET=change-this-auth-secret-before-deploying
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# GitHubの数値ユーザーID。ログイン名ではなく変更されないIDで本人を限定します。
AUTH_ALLOWED_GITHUB_ID=
